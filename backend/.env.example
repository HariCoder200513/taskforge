# Backend runtime config for LOCAL development.
# Copy to backend/.env and fill in real values. backend/.env is gitignored —
# never commit real secrets.
#
# Load it when running the app, e.g.:
#   set -a; . ./.env; set +a; ./mvnw spring-boot:run       # (from backend/)
# or run the container against it:
#   docker run --env-file backend/.env -p 8080:8080 taskforge-backend
#
# These keys override the ${...} placeholders in src/main/resources/application.yml.

# --- Database (Neon dev, or a local Postgres) ---
DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DB_USERNAME=<user>
DB_PASSWORD=<password>

# --- Auth / cookies (local dev defaults) ---
# Dev runs over plain HTTP, so the refresh cookie is not marked Secure.
AUTH_COOKIE_SECURE=false
# Browser origin allowed on the cookie endpoints (/auth/refresh, /auth/logout).
AUTH_CSRF_ORIGINS=http://localhost:5173
# CORS is off because the Vite dev server proxies the API same-origin. Enable it
# only if the browser calls the API on a different origin directly.
AUTH_CORS_ENABLED=false
AUTH_CORS_ORIGINS=http://localhost:5173

# --- Worker engine ---
WORKER_ENABLED=true

# --- First admin (optional): promote this already-registered user on startup ---
# AUTH_BOOTSTRAP_ADMIN_EMAIL=you@example.com

# --- JWT signing keys (optional) ---
# Leave blank to generate an ephemeral keypair at startup (tokens die on restart).
# Set a persistent RSA keypair (PEM contents) to survive restarts.
# AUTH_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
# AUTH_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
