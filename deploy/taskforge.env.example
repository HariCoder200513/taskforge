# Runtime config for the API container. Copy this to the HOST (not the repo) at
#   /opt/taskforge/taskforge.env   (sudo, root-owned, chmod 600)
# The Jenkins Deploy stage runs: docker run --env-file /opt/taskforge/taskforge.env ...
# NEVER commit the real file — it holds secrets.

DB_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=<neon-password>

# Plain HTTP for now (no TLS); set true once HTTPS is in front.
AUTH_COOKIE_SECURE=false

# Recommended for production so tokens survive container restarts (otherwise an
# ephemeral keypair is generated at startup). Paste PEM contents.
# AUTH_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
# AUTH_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
